# Answering model. Providers: groq | gemini | openai | ollama
LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# GEMINI_API_KEY=

# Judge model for the eval suite. Use a different model from the answering one.
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=qwen/qwen3.8-27b

# Leave unset to use embedded Qdrant under data/qdrant; docker-compose sets it.
# QDRANT_URL=http://localhost:6333
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
