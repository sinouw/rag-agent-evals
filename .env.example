# Answering model. Providers: groq | gemini | openai | ollama
LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
# GEMINI_API_KEY=

# Judge model for the eval suite (defaults to the answering provider's default model).
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-2.5-flash

# Leave unset to use embedded Qdrant under data/qdrant; docker-compose sets it.
# QDRANT_URL=http://localhost:6333
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
